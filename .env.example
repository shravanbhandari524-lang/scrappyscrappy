# DeepCrawl Environment Configuration Example

# Port for the Express API server (default: 3000)
PORT=3000

# Optional API key for /api/* and /screenshots/* (if empty, authentication is disabled)
API_KEY=

# Job time-to-live in minutes before memory and screenshots cleanup (default: 60)
JOB_TTL_MINUTES=60

# Optional LLM Form-Filling Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_MAX_CALLS=30
LLM_MAX_SUBMITS_PER_PAGE=2
# Set LLM_MOCK=1 to run tests with mocked LLM responses without an OpenAI key
LLM_MOCK=
